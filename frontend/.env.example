# Copy to .env.local for local overrides.

# Public URL of the deployed site (canonical, hreflang, Open Graph, sitemap)
VITE_SITE_URL=http://localhost:5173

# Backend API base. Leave empty to run the site in demo mode (forms stay in the browser).
VITE_API_URL=
# Example with the local backend:
# VITE_API_URL=http://localhost:4000/api/v1

# Google Identity Services client id (used only when VITE_API_URL is set)
VITE_GOOGLE_CLIENT_ID=

# Base path for sub-folder hosting such as GitHub Pages, e.g. /nuvela-hair-clinic/
BASE_PATH=/
