# Copy to .env and adjust. Never commit the real .env file.
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000

# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nuvela?schema=public"

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
TRUST_PROXY=false

# Auth (use long random strings in production)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
OTP_SECRET=change-me-too
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Return the OTP in the API response (development only)
OTP_DEV_ECHO=true
SMS_PROVIDER=console

# Google Identity Services client id (optional)
GOOGLE_CLIENT_ID=

# Uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5

# Optional: staff admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@nuvela-clinic.example
SEED_ADMIN_PASSWORD=change-me-admin-password
